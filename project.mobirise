          "_name": "features16",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features16\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card Color\" name=\"cardColor\" value=\"#fafafa\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"content-wrapper\">\n            <div class=\"row align-items-center\">\n                <div class=\"col-12 col-lg\">\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Хүний эрхийн хэрэгжилтийн баримтжуулалт, үр нөлөөнөөс...&nbsp;</b></h6>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">1.\tНҮБ-ын Хүний эрхийн зөвлөлд 2010 онд “Уул уурхай ба хүний эрх”; 2014 онд “Байгаль орчны эрх ба уул уурхай”; 2019 онд “Бодлогын уялдаагүй хөгжил- уул уурхай” илтгэлүүдийг Хүний эрхийн ТББ-уудтай хамтран боловсруулж илгээснээр МУ-ын ЗГ-т тухай бүрт зөвлөмж хүргүүлж ирсэн.\n<br>2.\tТХЗ-2030 дэлхийн зорилтуудын ТХЗ-6 усны эрх; ТХЗ-13 уур амьсгалын өөрчлөлт; ТХЗ-15 биологийн төрөл зүйл түүний орчны асуудлаар шалгуур үзүүлэлтүүдэд санал боловсруулж дэвшүүлэх- (2018 он) ИНБ-ын сайн дурын үнэлгээ хийж тайлан боловсруулахад дээрх 3 зорилтыг хариуцан ажиллаж байна. \n<br>3.\tНҮБ-ын Эмэгтэйчүүдийг алагчлах бүх хэлбэрийг устгах тухай конвенцын хэрэгжилт ИНБ-ын альтернатив тайлан боловсруулах багт ажиллаж конвенцын 14-р зүйл Хөдөөгийн эмэгтэйчүүдийн эрхийн асуудлаар тайлан боловсруулж ЗГ-т хүргүүлэх 7 зөвлөмжийг гаргасан. \n<br>4.\tЭдийн засаг, нийгэм, соёлын эрхийн пактын хэрэгжилтийн тайлангийн ТББ-уудын сүүдэр илтгэл боловсруулах багт ажиллан “уул уурхайн бодлого, түүний хэрэгжилт нь нүүдлийн уламжлалт соёл, малчдын амжиргаа, орон байртай байх эрхэд сөрөг нөлөөлөл үзүүлж байгаа” талаар тайланд оруулснаар МУ-ын Засгийн газарт маш тодорхой байдлаар “уул уурхайн салбарын бодлогоо малчдын эдийн засаг, соёлын эрхэд сөрөг нөлөөлөл үзүүлэхээргүйгээр дахин харж, хэрэгжилтэд хяналт тавьж ажиллах” гурван зөвлөмж өгсөн. \n<br>5.\t2016; 2020; 2024 оны парламентийн ээлжит сонгуульд өрсөлдөгч улс төрийн намуудын мөрийн хөтөлбөрт байгаль орчин, малчдын эрх, хүнсний эрх, бүс нутгийн хөгжлийн асуудлаарх бодлогод дүн шинжилгээ хийж, Тогтвортой хөгжлийн зорилтыг хэрэгжүүлэх зорилго бүхий ИН-ийн сүлжээ ТББ-уудтай хамтран ажиллаж  ирлээ.&nbsp;&nbsp;<br></p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-warning\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn more</a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg-{{imageWidth}}\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"../_images/square/sq2.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
